<mjml>
    <mj-include path="../../../templates/emails/email_styles.mjml"/>

    <mj-body>
        <mj-include path="../../../templates/emails/email_top.mjml"/>

        <mj-section>
            <mj-column>
                <mj-text>
                    {% blocktrans %}
                    Confirm that you want to use this address for your Metaculus account.
                    Open the link while signed in to that account and press Confirm.
                    {% endblocktrans %}
                </mj-text>

                <mj-text color="#6B7280" font-size="13px">
                    {% blocktrans %}
                    If you didn't request this, ignore this email; nothing changes.
                    {% endblocktrans %}
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-wrapper mj-class="content-block-wrapper" css-class="content-block-wrapper-loose">
            <mj-section mj-class="content-block" padding="8px 24px">
                <mj-column padding="0px">
                    <mj-button mj-class="cta-button" href="{{ confirm_link }}" padding-top="16px">
                        Confirm email address
                    </mj-button>

                    <mj-text
                        align="center"
                        color="#7C8894"
                        font-size="11px"
                        line-height="16px"
                        padding="10px 0px 6px">
                        {% blocktrans %}Expires in 24 hours{% endblocktrans %}
                    </mj-text>
                </mj-column>
            </mj-section>
        </mj-wrapper>

        <mj-section>
            <mj-column>
                <mj-text align="center" color="#6B7280" font-size="13px" padding-top="8px">
                    {% blocktrans %}
                    Or, copy and paste this link into your browser:
                    {% endblocktrans %}
                    <br/>
                    <a href="{{ confirm_link }}" style="color: #0A66C2; word-break: break-all;">{{ confirm_link }}</a>
                </mj-text>
            </mj-column>
        </mj-section>

        <mj-include path="../../../templates/emails/email_greeting.mjml"/>
    </mj-body>
</mjml>
